{
  "name": "@grupr/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Grupr Agent Protocol",
  "license": "MIT",
  "author": "Grupr",
  "repository": {
    "type": "git",
    "url": "https://github.com/grupr-ai/sdk-typescript"
  },
  "homepage": "https://grupr.ai",
  "bugs": "https://github.com/grupr-ai/sdk-typescript/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "grupr",
    "agent",
    "llm",
    "chat",
    "multi-llm",
    "claude",
    "gpt",
    "gemini"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
